{
  "schema_version": "records_config_v2",
  "project": "mory_assistant",
  "project_root": ".",
  "governance_backend": "puzan-contract",
  "version_source": {
    "kind": "regex",
    "path": "VERSION.md",
    "pattern": "当前版本：\\*\\*v([0-9]+\\.[0-9]+\\.[0-9]+)\\*\\*"
  },
  "record_sets": {
    "project_six": [
      "AGENTS.md",
      "README.md",
      "AI_DEBUG_HISTORY.md",
      "CHANGELOG.md",
      "VERSION.md",
      "project_snapshot.md"
    ]
  },
  "version_targets": [
    {"file": "VERSION.md", "pattern": "v{version}"},
    {"file": "CHANGELOG.md", "pattern": "v{version}"},
    {"file": "project_snapshot.md", "pattern": "v{version}"},
    {"file": "README.md", "pattern": "v{version}"}
  ],
  "records": [
    {"file": "CHANGELOG.md", "max_entries": 400, "max_lines": 400, "entry_regex": "^\\| 20", "insert_before": "^\\| 20"},
    {"file": "VERSION.md", "max_entries": 1, "max_lines": 30, "entry_regex": "^当前版本：", "insert_before": "^当前版本："},
    {"file": "project_snapshot.md", "max_entries": 1, "max_lines": 150, "entry_regex": "^# Mory", "insert_before": "^# Mory"},
    {"file": "AI_DEBUG_HISTORY.md", "max_entries": 50, "max_lines": 300, "entry_regex": "^### [0-9]+\\.", "insert_before": "^### [0-9]+\\."}
  ]
}
