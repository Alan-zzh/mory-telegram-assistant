"""
╔══════════════════════════════════════════════════════════════════════════╗
║  modules/auto_tasks.py  ·  后台自动任务引擎                           ║
║                                                                        ║
║  功能：以daemon线程运行，每60秒轮询一次，执行以下任务：                 ║
║                                                                        ║
║    1. 每日9点新闻播报+早安问候 -> ai.ask(mode="news") -> 发到主群        ║
║    1b. 每日13点新闻播报+午安问候 -> ai.ask(mode="afternoon_news") -> 主群  ║
║    1c. 每日20:30新闻播报+晚安问候 -> ai.ask(mode="evening_news") -> 主群    ║
║    2. 叫醒服务 -> 每分钟检查是否有用户设定的叫醒时间                   ║
║    3. 阅后即焚-孤儿清理 -> 24h未被回复的机器人消息自动删除             ║
║    4. 阅后即焚-原消息探测 -> 每3分钟对近10分钟的追踪消息做forward探测    ║
║       原消息已被删/撤回 -> 立即删除机器人对应回复                         ║
║       注意：pyTelegramBotAPI不支持deleted_messages_handler，               ║
║             因此用forward探测代替，延迟约3-5分钟，效果一致                   ║
║    5. 醋意挽回 -> 3天未活跃的用户，25%概率发送撩拨消息                 ║
║    6. 购物车挽回 -> 24h前触发过价格关键词的用户，发送私聊撩拨           ║
║    7. 背刺泄密 -> 每周最多1次，随机时间触发，AI生成绝对不重复的爆料    ║
║    8. 每小时数据备份 -> 复制mory.db到backup/，保留7天                 ║
║    9. 保存config -> 仅模型索引变化时保存（不在每次循环保存）           ║
║                                                                        ║
║  启动方式：main.py -> start_background(bot, config, db, ai, save_config)║
║  注意：此线程为daemon，主进程退出时自动终止。                          ║
╚══════════════════════════════════════════════════════════════════════════╝
"""

import time
import random
import shutil
import glob
import os
import logging
import threading
import hashlib
from datetime import datetime, timedelta, timezone

logger = logging.getLogger("auto_tasks")

# 记录上次保存的模型索引，避免重复写文件
_last_saved_model_idx = None


def _send_and_track(bot, chat_id, text, db, user_msg_id=0):
    """发送消息并自动追踪阅后即焚（user_msg_id=0 表示主动消息，24h孤儿清理）"""
    try:
        sent = bot.send_message(chat_id, text)
        if sent and chat_id < 0:  # 群聊才追踪
            db.track_reply(sent.message_id, chat_id, user_msg_id)
        return sent
    except Exception as e:
        logger.error(f"发送+追踪失败：{e}")
        return None


def start_background(bot, config: dict, db, ai, save_config_fn):
    """启动后台守护线程"""
    t = threading.Thread(
        target=_task_loop,
        args=(bot, config, db, ai, save_config_fn),
        daemon=True,
        name="AutoTasks"
    )
    t.start()
    logger.info("🚀 后台自动任务引擎启动")


def _task_loop(bot, config: dict, db, ai, save_config_fn):
    global _last_saved_model_idx
    last_backup_hour = -1
    last_news_day = -1
    last_news_13_day = -1  # 午间新闻防重
    last_news_20_day = -1  # 晚间新闻防重
    last_morning_day = -1  # 早安防重
    last_afternoon_day = -1  # 午安防重
    last_evening_day = -1  # 晚安防重
    last_leak_week = -1  # ISO周号，每周最多1次
    leak_history = []     # 已发送过的泄露内容哈希，防重复
    last_probe_time = 0   # 阅后即焚探测时间戳
    # 时区：VPS默认UTC，强制用北京时间(UTC+8)判断定时任务
    _CST = timezone(timedelta(hours=8))

    while True:
        try:
            now = datetime.now(_CST)
            ts = int(time.time())
            time_str = now.strftime("%H:%M")

            # ── 1. 每日9点新闻播报（走心走肾随机结尾）───────────────────
            gid = config.get("GROUP_ID", 0)
            if now.hour == 9 and now.minute < 2 and now.day != last_news_day:
                if gid != 0:
                    logger.info("📰 触发每日新闻播报(早)")
                    seed = random.randint(100000, 999999)
                    news = ai.ask("今日新闻", mode="news", seed=seed)
                    if news:
                        try:
                            _send_and_track(bot, gid, f"📰 【每日新闻简报】\n{news}", db)
                            last_news_day = now.day
                        except Exception as e:
                            logger.error(f"新闻播报失败：{e}")

            # ── 1b. 每日13点新闻播报（走心走肾随机结尾）──────────────────
            if now.hour == 13 and now.minute < 2 and now.day != last_news_13_day:
                if gid != 0:
                    logger.info("📰 触发午间新闻播报")
                    seed = random.randint(100000, 999999)
                    news = ai.ask("今日新闻", mode="afternoon_news", seed=seed)
                    if news:
                        try:
                            _send_and_track(bot, gid, f"📰 【午间新闻简报】\n{news}", db)
                            last_news_13_day = now.day
                        except Exception as e:
                            logger.error(f"午间新闻播报失败：{e}")

            # ── 1c. 每日20:30新闻播报（走心走肾随机结尾）────────────────
            if now.hour == 20 and now.minute >= 30 and now.minute < 32 and now.day != last_news_20_day:
                if gid != 0:
                    logger.info("📰 触发晚间新闻播报")
                    seed = random.randint(100000, 999999)
                    news = ai.ask("今日新闻", mode="evening_news", seed=seed)
                    if news:
                        try:
                            _send_and_track(bot, gid, f"📰 【晚间新闻简报】\n{news}", db)
                            last_news_20_day = now.day
                        except Exception as e:
                            logger.error(f"晚间新闻播报失败：{e}")

            # ── 1d. 早安问候(8:00) 含绿茶风隐晦引导 ────────────────────
            if now.hour == 8 and now.minute < 2 and now.day != last_morning_day:
                if gid != 0:
                    seed = random.randint(100000, 999999)
                    msg = ai.ask("早安", mode="morning", seed=seed)
                    if msg:
                        msg = msg.replace("\n", " ").strip()[:100]  # 强制单行+截断
                        try:
                            _send_and_track(bot, gid, f"☀️ {msg}", db)
                            logger.info(f"☀️ 早安已发送：{msg}")
                            last_morning_day = now.day
                        except Exception as e:
                            logger.error(f"早安问候失败：{e}")

            # ── 1e. 午安问候(12:30) 含绿茶风隐晦引导 ───────────────────
            if now.hour == 12 and now.minute >= 30 and now.minute < 32 and now.day != last_afternoon_day:
                if gid != 0:
                    seed = random.randint(100000, 999999)
                    msg = ai.ask("午安", mode="afternoon", seed=seed)
                    if msg:
                        msg = msg.replace("\n", " ").strip()[:100]  # 强制单行+截断
                        try:
                            _send_and_track(bot, gid, f"🍃 {msg}", db)
                            logger.info(f"🍃 午安已发送：{msg}")
                            last_afternoon_day = now.day
                        except Exception as e:
                            logger.error(f"午安问候失败：{e}")

            # ── 1f. 晚安问候(23:00) 含绿茶风隐晦引导 ───────────────────
            if now.hour == 23 and now.minute < 2 and now.day != last_evening_day:
                if gid != 0:
                    seed = random.randint(100000, 999999)
                    msg = ai.ask("晚安", mode="evening", seed=seed)
                    if msg:
                        msg = msg.replace("\n", " ").strip()[:100]  # 强制单行+截断
                        try:
                            _send_and_track(bot, gid, f"🌙 {msg}", db)
                            logger.info(f"🌙 晚安已发送：{msg}")
                            last_evening_day = now.day
                        except Exception as e:
                            logger.error(f"晚安问候失败：{e}")

            # ── 2. 叫醒服务 ─────────────────────────────────────────────
            for uid, wake_time in db.get_all_wake_ups():
                if wake_time == time_str:
                    try:
                        bot.send_message(uid,
                            "起床啦哥哥～ 太阳晒屁股了，"
                            f"新的一天也要像爱{config['BOT_NAME']}老板一样充满活力哦！☀️")
                    except:
                        pass

            # ── 3. 阅后即焚：24h孤儿清理 ────────────────────────────────
            for bot_mid, cid, user_mid in db.get_orphan_messages():
                try:
                    bot.delete_message(cid, int(bot_mid))
                    logger.info(f"🗑️ 清理孤儿消息 {bot_mid}")
                except:
                    pass

            # ── 4. 阅后即焚：原消息探测（每3分钟一次）────────────────────
            #    对近10分钟内未被回复的机器人消息，用 forward 探测原消息是否还在
            #    如果原消息已被删/撤回 → 立即删除机器人回复
            if ts - last_probe_time >= 180:  # 3分钟
                last_probe_time = ts
                unconfirmed = db.get_unconfirmed_messages(1200)  # 20分钟窗口
                if unconfirmed:
                    logger.info(f"🔥 阅后即焚探测：{len(unconfirmed)}条消息待检查")
                for bot_mid, cid, user_mid in unconfirmed:
                    if user_mid == 0:
                        continue  # 主动消息无原消息可探测，走24h孤儿清理即可
                    try:
                        probe = bot.forward_message(
                            config["ADMIN_ID"], cid, user_mid,
                            disable_notification=True
                        )
                        bot.delete_message(config["ADMIN_ID"], probe.message_id)
                    except Exception as e:
                        err = str(e).lower()
                        if "not found" in err or "message_id_invalid" in err or "bad request" in err:
                            # 原消息被撤回或删除
                            try:
                                bot.delete_message(cid, int(bot_mid))
                                db.delete_tracked(bot_mid)
                                logger.info(f"🔥 阅后即焚触发(探测)，删除 {bot_mid}")
                            except Exception as del_err:
                                logger.error(f"🔥 阅后即焚删除失败 {bot_mid}: {del_err}")
                        else:
                            logger.warning(f"🔥 阅后即焚探测异常 {bot_mid}: {e}")

            # ── 5. 醋意挽回（3天未活跃）─────────────────────────────────
            three_days_ago = ts - 259200
            inactive = db.get_inactive_users(three_days_ago, config.get("ADMIN_ID", 0))
            for uid, name in inactive[:3]:  # 每轮最多3个，避免刷屏
                if random.random() < 0.25:  # 25%概率
                    try:
                        bot.send_message(uid,
                            f"哥哥，这几天去哪了？是不是去看别的妹妹了？"
                            f"{config['BOT_NAME']}老板都问起你了哼！")
                        db.reset_last_active(uid)
                        logger.info(f"💌 醋意挽回：{uid}")
                    except:
                        pass

            # ── 6. 购物车挽回（24h后私信撩拨）───────────────────────────
            for uid in db.get_expired_carts(86400):
                try:
                    bot.send_message(uid,
                        f"哥哥昨天问了门槛又没来，是{config['BOT_NAME']}哪里不够好吗？"
                        f"来陪小助理聊聊天嘛～")
                    db.funnel_touch(uid, "interested")
                    logger.info(f"🛒 购物车挽回：{uid}")
                except:
                    pass

            # ── 7. 背刺泄密（每周最多1次，随机时间，AI绝对不重复）────────
            gid = config.get("GROUP_ID", 0)
            current_week = now.isocalendar()[1]  # ISO周号
            if gid != 0 and current_week != last_leak_week:
                # 每次循环有1/480概率触发（约8小时窗口内大概率触发一次）
                if random.randint(1, 480) == 1:
                    # 构造独特的prompt，确保AI每次生成完全不同的内容
                    seed = random.randint(100000, 999999)
                    hour_hint = random.choice(["早上", "中午", "下午", "傍晚", "深夜", "凌晨", "半夜"])
                    scene_hint = random.choice([
                        "在便利店买东西", "一个人看电视剧", "刷手机的时候",
                        "发呆的时候", "跟闺蜜聊天", "自拍的时候", "做饭的时候",
                        "洗澡前", "刚睡醒", "走路的时候", "吃零食的时候",
                        "整理房间", "加班的时候", "逛街的时候", "坐地铁的时候",
                        "打视频电话", "化妆的时候", "喝奶茶的时候", "拍照片",
                        "换衣服的时候", "听歌的时候", "写日记", "敷面膜的时候",
                        "逛超市", "下雨天在家", "喝咖啡的时候", "吃火锅的时候",
                    ])
                    leak_prompt = (
                        f"种子{seed}，场景：{scene_hint}。"
                        f"用极度八卦、偷偷摸摸的语气，泄露一个关于Mory老板非常可爱、"
                        f"生活化的小癖好或小秘密。要求：\n"
                        f"1. 必须是全新的、独特的内容，绝对不能重复\n"
                        f"2. 要有画面感和生活气息\n"
                        f"3. 控制在25字以内\n"
                        f"4. 不要出现任何编号、序号或列表格式"
                    )
                    leak = ai.ask(leak_prompt, mode="leak")
                    if leak:
                        # 哈希去重
                        content_hash = hashlib.md5(leak.encode()).hexdigest()[:8]
                        if content_hash not in leak_history:
                            leak_history.append(content_hash)
                            # 只保留最近20条哈希
                            if len(leak_history) > 20:
                                leak_history = leak_history[-20:]
                            try:
                                _send_and_track(bot, gid,
                                    f"🤫 老板不在... 偷偷跟你们说：\n\n{leak}", db)
                                last_leak_week = current_week
                                logger.info(f"🤫 背刺泄密触发(周{current_week})：{leak[:30]}")
                            except:
                                pass

            # ── 8. 每小时数据备份 ────────────────────────────────────────
            if now.hour != last_backup_hour:
                _do_backup(db.db_file)
                last_backup_hour = now.hour

            # ── 9. 保存config（仅模型索引变化时）────────────────────────
            current_idx = config.get("CURRENT_MODEL_INDEX", 0)
            if _last_saved_model_idx is None or _last_saved_model_idx != current_idx:
                save_config_fn()
                _last_saved_model_idx = current_idx

        except Exception as e:
            logger.error(f"❌ 后台任务异常：{e}", exc_info=True)

        time.sleep(60)  # 每分钟一个循环


def _do_backup(db_file: str):
    """执行数据库备份，保留最近7天（168份）"""
    os.makedirs("backup", exist_ok=True)
    ts_str = datetime.now().strftime("%Y%m%d_%H00")
    dest = f"backup/mory_backup_{ts_str}.db"
    try:
        shutil.copy(db_file, dest)
        # 只保留最近168份
        backups = sorted(glob.glob("backup/mory_backup_*.db"))
        for old in backups[:-168]:
            os.remove(old)
        logger.info(f"💾 备份完成：{dest}")
    except Exception as e:
        logger.error(f"备份失败：{e}")
