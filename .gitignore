# ══════════════════════════════════════════════════════════════════════════
# Mory小助理 .gitignore
# ══════════════════════════════════════════════════════════════════════════

# ── 🔴 绝对禁止提交（含密钥/Token/密码）──────────────────────────────────
config.json
.env
.env.*
!.env.example
backups/
backup/
logs/
*.db
*.db-journal
*.db-wal
_ssh_known_hosts

# ── 🟡 敏感脚本（临时诊断/修复用，含VPS密码）─────────────────────────────
force_*.py
!modules/force_channel.py
!modules/force_subscribe.py
verify_*.py
!scripts/verify_db_methods.py
check_*.py
!scripts/check_config_sync.py
!scripts/check_deploy_ready.py
!tasks/maintenance/check_db_migration_task.py
!tasks/maintenance/check_expired_redpackets_task.py
fix_*.py
diagnostic*.py
scan*.py
!scripts/scan_group.py
deploy_*.py
!deploy_vps.py
!core/deploy_utils.py
full_sync*.py

# ── 根目录临时测试文件（下划线前缀，已归档到 tests/_archive/）────────────
_*.py
_*_*.py
!**/__init__.py

# ── 备份 & 临时文件 ──────────────────────────────────────────────────────
backup_*/
_archive*/
_old*/
_temp*/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log
*.tmp
*.zip
*.bak
*.sync-conflict-*
reload_flag
fault_dedup_state.json
# 运行时数据目录：仅三个内容文案文件入库（非敏感、新克隆必需），其余不入库
data/*
!data/badges.json
!data/fortune_texts.json
!data/tarot_cards.json
💾 备份/

# 根目录临时输出文件
tmp_*.txt
test_out.txt
test*.txt

# 播报样张与字体不入库（bg 样张为生成产物；字体 19MB 由 deploy_vps.py 单独同步）
assets/broadcast/
assets/fonts/
runtime/cache/
runtime/demo_*.py
runtime/demo_*.png
# 验收/排查过程产物（证据脚本与中间载荷，不提交）
runtime/wait_*_evidence.py
runtime/*_payload_b64.txt
# 【v5.41.0】运行时目录整体不入库：历史审计/验证/子代理产物与一次性脚本
# 本地磁盘保留作证据（AGENTS.md 审计报告落点不变），git 不再跟踪。
runtime/*

# 临时诊断/运维脚本（含硬编码VPS路径/Token/群ID，不提交）
scripts/vps_*.py
!scripts/vps_watchdog.py
scripts/bruteforce_delete.py
scripts/clean_restart.py
scripts/emergency_ban_ad_user.py
scripts/probe_msg_ids.py
scripts/try_get_old_updates.py
scripts/upload_and_ban.py

# ── 依赖 ─────────────────────────────────────────────────────────────────
node_modules/
venv/
.venv/
uv.lock
_quarantine_*/
*.egg-info/

# ── IDE & 系统 ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ── 缓存目录 ──────────────────────────────────────────────────────────────
.cache/

# ── AI工作目录（不含业务代码）──────────────────────────────────────────────
.trae/

# ── runtime 浏览器扫描临时产物（probe/crawl/screenshot，不提交）────────────
runtime/browser-scan/
runtime/audit-reports/project-automation/*.json

# task-report 图形化完工报告（本机交付产物，不进入版本库）
reports/

# ── AI 审查/分析产物（better-harness 等，不提交）────────────────────
.qoder/
.better-harness/
.codebuddy/