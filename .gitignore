# ══════════════════════════════════════════════════════════════════════════
# Mory小助理 .gitignore
# ══════════════════════════════════════════════════════════════════════════

# ── 🔴 绝对禁止提交（含密钥/Token/密码）──────────────────────────────────
config.json
.env
.env.*
!.env.example
backups/
backup/
logs/
*.db
*.db-journal
*.db-wal
_ssh_known_hosts

# ── 🟡 敏感脚本（临时诊断/修复用，含VPS密码）─────────────────────────────
force_*.py
verify_*.py
check_*.py
fix_*.py
diagnostic*.py
scan*.py
deploy_*.py
!deploy_vps.py
full_sync*.py

# ── 根目录临时测试文件（下划线前缀，已归档到 tests/_archive/）────────────
_*.py
_*_*.py

# ── 备份 & 临时文件 ──────────────────────────────────────────────────────
backup_*/
_archive*/
_old*/
_temp*/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log
*.tmp
*.zip
*.bak
reload_flag
data/
💾 备份/

# ── 依赖 ─────────────────────────────────────────────────────────────────
node_modules/
venv/
.venv/
*.egg-info/

# ── IDE & 系统 ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ── 缓存目录 ──────────────────────────────────────────────────────────────
.cache/

# ── AI工作目录（不含业务代码）──────────────────────────────────────────────
.trae/
