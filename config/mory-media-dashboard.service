[Unit]
Description=Mory Media Dashboard（多Bot独立Dashboard）
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/mory_assistant
# 媒体 Bot 的 Dashboard，使用独立端口和数据库
# 用 python3 -m gunicorn 替代直接 gunicorn 路径
ExecStart=/usr/bin/python3 -m gunicorn -k gevent -w 2 -b 0.0.0.0:6617 dashboard.wsgi:app
Restart=always
RestartSec=5
EnvironmentFile=/home/ubuntu/mory_assistant/.env
Environment=PYTHONUNBUFFERED=1
Environment=DASHBOARD_MODE=media
Environment=DASHBOARD_PORT=6617

[Install]
WantedBy=multi-user.target
