[Unit]
Description=Mory Assistant Bot
After=network.target
# 防止反复崩溃重启风暴：300 秒内最多重启 10 次，超过则停止重启
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/mory_assistant
# 加 EnvironmentFile 确保凭据（TG_TOKEN、DASHSCOPE_KEY等）注入到进程
EnvironmentFile=/home/ubuntu/mory_assistant/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
