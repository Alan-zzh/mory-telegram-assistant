# Mory小助理 环境变量配置模板
# 复制此文件为 .env 并填入实际值：cp .env.example .env

# ============ 必填项 ============

# Telegram Bot Token（从 @BotFather 获取）
# 代码中通过 TG_TOKEN 环境变量覆盖 config.json 的 TOKEN 字段
TG_TOKEN=

# AI API密钥（通义千问 DashScope）
# 代码中通过 DASHSCOPE_KEY 环境变量覆盖 config.json 的 API_KEY 字段
DASHSCOPE_KEY=

# ============ 多模型协同路由（阶段3-A）============
# 用途：按任务类型路由到不同 LLM（高端/标准/廉价），支持跨厂商
# 启用条件：config.json 中 MODEL_ROUTER_ENABLED=true
# 未配置时回退到 DASHSCOPE_KEY（向后兼容）

# 高端模型 API Key（角色扮演对话：Qwen-Max / GPT-4o）
PREMIUM_MODEL_API_KEY=

# 标准模型 API Key（内容审核/广告检测：DeepSeek-V3 / Qwen-Plus）
STANDARD_MODEL_API_KEY=

# 廉价模型 API Key（记忆摘要/简单分类：Qwen-Flash / DeepSeek-V3-lite，可复用百炼）
LIGHT_MODEL_API_KEY=

# ============ 可选项（环境变量优先于 config.json）============

# 管理员 Telegram 用户ID（环境变量优先，兜底读 config.json）
# ADMIN_ID=

# 主群ID（负数，环境变量优先，兜底读 config.json）
# GROUP_ID=

# ============ Dashboard后台 ============

# Dashboard密钥（至少16位，推荐用下面命令生成）
# python3 -c 'import secrets;print(secrets.token_hex(32))'
DASHBOARD_SECRET=

# Dashboard登录密码（至少6位）
DASHBOARD_PASSWORD=

# Dashboard只读查看者密码（可选，至少6位。设置后可用此密码以只读模式登录，无法修改配置）
# DASHBOARD_VIEWER_PASSWORD=

# Dashboard端口（默认6616，代码中通过 os.environ.get("DASHBOARD_PORT", 6616) 读取）
DASHBOARD_PORT=6616

# Dashboard启用HTTPS（设为true时SESSION_COOKIE_SECURE=true，HTTP访问时留空或false）
# DASHBOARD_HTTPS=true

# Dashboard模式（main=主Bot，media=媒体Bot，用于多Bot分区部署）
# DASHBOARD_MODE=main

# ============ VPS连接 ============

# VPS IP地址
VPS_HOST=

# VPS SSH端口（默认22）
VPS_PORT=22

# VPS SSH用户名（默认ubuntu）
VPS_USER=ubuntu

# VPS SSH私钥路径（可选；未填时尝试 ~/.ssh/id_ed25519_deploy、id_ed25519、id_rsa）
VPS_SSH_KEY=

# VPS SSH密码（未配置SSH key时需要）
VPS_SSH_PASS=

# VPS项目路径（默认/home/ubuntu/mory_assistant）
VPS_PATH=/home/ubuntu/mory_assistant

# ============ 说明 ============
# python-dotenv 包会自动加载此文件到环境变量
# 安装依赖：pip install python-dotenv

# 以下变量在代码中存在但未通过环境变量读取（仅 config.json 配置）：
# - ADMIN_ID：管理员用户ID
# - GROUP_ID：主群ID
# - LOG_LEVEL：日志级别（config.json 配置项，非环境变量，默认 INFO）
#
# 代码中实际读取的环境变量：
# - TG_TOKEN（main.py 第346-347行）
# - DASHSCOPE_KEY（main.py 第348-349行）
# - DASHBOARD_SECRET（dashboard/app.py）
# - DASHBOARD_PASSWORD（dashboard/auth.py）
# - DASHBOARD_VIEWER_PASSWORD（dashboard/auth.py）
# - DASHBOARD_PORT（dashboard/app.py，默认6616）
# - DASHBOARD_HTTPS（dashboard/auth.py）
# - DASHBOARD_MODE（dashboard/helpers.py，默认main）
# - VPS_HOST/VPS_PORT/VPS_USER/VPS_SSH_PASS/VPS_PATH（core/vps_config.py）

# ============ 告警 Bot（独立通道，不复用业务 Bot）============
# 用途：业务 Bot 卡死时仍能发出告警；Token 未配置时降级为仅写日志
# ALERT_BOT_TOKEN：从 @BotFather 获取独立 Bot Token
# ALERT_CHAT_ID：接收告警的管理员群组/私聊 ID（负数为群组）
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=
