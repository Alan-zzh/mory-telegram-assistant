# Mory小助理 环境变量配置模板
# 复制此文件为 .env 并填入实际值：cp .env.example .env

# ============ 必填项 ============

# Telegram Bot Token（从 @BotFather 获取）
# 代码中通过 TG_TOKEN 环境变量覆盖 config.json 的 TOKEN 字段
TG_TOKEN=

# AI API密钥（通义千问 DashScope）
# 代码中通过 DASHSCOPE_KEY 环境变量覆盖 config.json 的 API_KEY 字段
DASHSCOPE_KEY=

# Google Gemini API密钥
GOOGLE_API_KEY=

# ============ 可选项（仅通过 config.json 配置，非环境变量）============

# 管理员 Telegram 用户ID（在 config.json 中配置，非环境变量）
# ADMIN_ID=

# 主群ID（负数，在 config.json 中配置，非环境变量）
# GROUP_ID=

# ============ Dashboard后台 ============

# Dashboard密钥（至少16位，推荐用下面命令生成）
# python3 -c 'import secrets;print(secrets.token_hex(32))'
DASHBOARD_SECRET=

# Dashboard登录密码（至少6位）
DASHBOARD_PASSWORD=

# ============ VPS连接 ============

# VPS IP地址
VPS_HOST=

# VPS SSH端口（默认22）
VPS_PORT=22

# VPS SSH用户名（默认root）
VPS_USER=root

# VPS SSH密码
VPS_SSH_PASS=

# VPS项目路径（默认/root/mory）
VPS_PATH=/home/ubuntu/mory_assistant

# ============ 说明 ============
# python-dotenv 包会自动加载此文件到环境变量
# 安装依赖：pip install python-dotenv

# 以下变量在代码中存在但未通过环境变量读取（仅 config.json 配置）：
# - ADMIN_ID：管理员用户ID
# - GROUP_ID：主群ID
# - LOG_LEVEL：日志级别（代码中硬编码为 INFO，未读取此环境变量）
#
# 代码中实际读取的环境变量：
# - TG_TOKEN（main.py 第346-347行）
# - DASHSCOPE_KEY（main.py 第348-349行）
# - DASHBOARD_SECRET（dashboard/app.py 第50行）
# - DASHBOARD_PASSWORD（dashboard/app.py 第180行）
# - VPS_HOST/VPS_PORT/VPS_USER/VPS_SSH_PASS/VPS_PATH（core/vps_config.py）
