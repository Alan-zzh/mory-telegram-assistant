{
  "server": {
    "host": "YOUR_SERVER_IP",
    "port": 22,
    "user": "root",
    "ssh_key": ""
  },
  "paths": {
    "remote_app_dir": "/opt/mory_assistant",
    "local_upload_items": [
      "."
    ],
    "exclude": [
      ".git",
      "__pycache__",
      "node_modules",
      ".venv",
      "venv",
      ".env",
      "restore_config.json",
      "recovery_upload.tar.gz"
    ]
  },
  "commands": {
    "before_upload": [
      "mkdir -p /opt/mory_assistant"
    ],
    "after_upload": [
      "cd /opt/mory_assistant && ls -la"
    ],
    "restart": [
      "cd /opt/mory_assistant && docker compose up -d"
    ],
    "verify": [
      "cd /opt/mory_assistant && docker compose ps"
    ]
  },
  "health_checks": [
    "http://YOUR_DOMAIN_OR_IP/"
  ]
}
